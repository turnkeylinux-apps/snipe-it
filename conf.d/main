#!/bin/bash -ex

DB_NAME=snipeit
DB_USER=snipeit
DB_PASS=$(mcookie)

ADMIN_USER="admin"
ADMIN_DOMAIN="example.com"
ADMIN_MAIL="${ADMIN_USER}@${ADMIN_DOMAIN}"
ADMIN_PASS=turnkey1
ADMIN_FNAME="TurnKey"
ADMIN_LNAME="Linux"

WEBROOT=/var/www/snipe-it
CONF=$WEBROOT/.env

service mysql start

mysqladmin create $DB_NAME
mysql --batch <<EOF
CREATE USER '$DB_USER'@'localhost' IDENTIFIED BY '$DB_PASS';
GRANT ALL PRIVILEGES ON $DB_NAME.* TO '$DB_USER'@'localhost';
FLUSH PRIVILEGES;
EOF

cd $WEBROOT
chown -R www-data:www-data $WEBROOT

[[ ! -f "$CONF" ]] && cp $CONF.example $CONF

sed -i "\|APP_URL=|s|=.*|=http://localhost|" $CONF
sed -i "\|DB_DATABASE=|s|=.*|=$DB_NAME|" $CONF
sed -i "\|DB_USERNAME=|s|=.*|=$DB_USER|" $CONF
sed -i "\|DB_PASSWORD=|s|=.*|=$DB_PASS|" $CONF
sed -i "\|MAIL_MAILER=|s|=.*|=sendmail|" $CONF
sed -i "\|MAIL_FROM_ADDR=|s|=.*|=$ADMIN_MAIL|" $CONF
sed -i "\|MAIL_REPLYTO_ADDR=|s|=.*|=$ADMIN_MAIL|" $CONF
sed -i "\|QUEUE_CONNECTION=|s|=.*|=redis|" $CONF
sed -i "\|REDIS_HOST=|s|=.*|=127.0.0.1|" $CONF
sed -i "\|REDIS_PASSWORD=|s|=.*|=null|" $CONF
sed -i "\|REDIS_PORT=|s|=.*|=6379|" $CONF

# Ensure that turnkey-artisan knows where webroot is
sed -i "\|^export WEBROOT| s|=.*|="$WEBROOT"|" /usr/local/bin/turnkey-artisan

chown -R www-data:www-data $WEBROOT

turnkey-composer install --no-dev --prefer-dist --no-interaction \
    --no-progress --optimize-autoloader
turnkey-artisan key:generate --force
turnkey-artisan config:clear

touch $WEBROOT/storage/logs/laravel.log
chown -R www-data:www-data $WEBROOT

a2dissite 000-default
a2enmod headers
a2ensite snipe-it
a2enmod rewrite

service apache2 start
service redis-server start

COOKIE=/tmp/snipe-it-setup-cookie
PAGE=/tmp/snipe-it-setup-page
HEADERS=/tmp/snipe-it-setup-headers

for _ in $(seq 1 30); do
    if curl --fail --silent --show-error --cookie-jar "$COOKIE" \
            http://localhost/setup >"$PAGE"; then
        break
    fi
    sleep 1
done
grep -Fqi 'Create database tables' "$PAGE"
TOKEN=$(sed -n 's/.*name="_token" value="\([^"]*\)".*/\1/p' "$PAGE" |
    head -n1)
test -n "$TOKEN"
curl --fail --silent --show-error --cookie "$COOKIE" --cookie-jar "$COOKIE" \
    --data-urlencode "_token=$TOKEN" http://localhost/setup/migrate >"$PAGE"
grep -Fqi 'Database Migrations' "$PAGE"

curl --fail --silent --show-error --cookie "$COOKIE" --cookie-jar "$COOKIE" \
    http://localhost/setup/user >"$PAGE"
TOKEN=$(sed -n 's/.*name="_token" value="\([^"]*\)".*/\1/p' "$PAGE" |
    head -n1)
test -n "$TOKEN"
curl --silent --show-error --cookie "$COOKIE" --cookie-jar "$COOKIE" \
    --data-urlencode "_token=$TOKEN" \
    --data-urlencode 'site_name=TurnKey Snipe-IT Asset Management' \
    --data-urlencode 'locale=en-US' \
    --data-urlencode 'default_currency=USD' \
    --data-urlencode 'auto_increment_prefix=' \
    --data-urlencode 'zerofill_count=5' \
    --data-urlencode "email_domain=$ADMIN_DOMAIN" \
    --data-urlencode 'email_format=filastname' \
    --data-urlencode "first_name=$ADMIN_FNAME" \
    --data-urlencode "last_name=$ADMIN_LNAME" \
    --data-urlencode "email=$ADMIN_MAIL" \
    --data-urlencode "username=$ADMIN_USER" \
    --data-urlencode "password=$ADMIN_PASS" \
    --data-urlencode "password_confirmation=$ADMIN_PASS" \
    --dump-header "$HEADERS" --output "$PAGE" \
    http://localhost/setup/user
grep -Eq '^HTTP/.* 30[12378]' "$HEADERS"
grep -Eqi '^Location: .*/setup/done' "$HEADERS"

rm -f "$COOKIE" "$PAGE" "$HEADERS"

service mysql stop
service apache2 stop
service redis-server stop
